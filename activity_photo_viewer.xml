<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center">
    <ImageView android:id="@+id/viewerImage" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter"
        android:contentDescription="Selected photo"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/previousButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Previous"/>
        <Button android:id="@+id/nextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Next"/>
    </LinearLayout>
</LinearLayout>
